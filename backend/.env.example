# --- Gemini: free-tier API key (primary) ---
# NOTE: free tier is 20 requests/day PER MODEL. The fallback chain pools the
# quota across models; when all are spent the app escalates to Vertex below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite-preview
GEMINI_THINKING_BUDGET=512

# --- Vertex AI escalation (real quota, billed to the GCP project) ---
# Requires:  gcloud auth application-default login
GCP_PROJECT_ID=variabl-482107
GCP_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# auto | gemini | claude | offline
LLM_PROVIDER=auto
ANALYZE_WORKERS=3
